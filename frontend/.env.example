# Grafted Frontend Environment
# Copy to .env.local for local overrides. Set VITE_API_URL in Vercel.

VITE_API_URL=http://localhost:3001

# Timeout for ordinary CRUD calls.
VITE_API_TIMEOUT_MS=30000

# Timeout for model-backed calls (ingest, chat, roadmap). These routinely take
# 10-20s; a job-description ingest has been measured at ~18s. Keep well above
# VITE_API_TIMEOUT_MS or the browser aborts work the server goes on to commit.
VITE_AI_TIMEOUT_MS=90000
