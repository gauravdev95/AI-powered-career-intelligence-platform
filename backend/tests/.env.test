# Environment for `npm test`. Committed on purpose — it contains no secrets.
# Tests run against an in-process PostgreSQL build (PGlite) with real pgvector, so
# the SQL, the vector operators and the schema under test are the production ones.
NODE_ENV=test
DATABASE_DRIVER=pglite
DATABASE_AUTO_MIGRATE=true

# No GEMINI_API_KEY: the suite deliberately runs with the provider unavailable, so it
# exercises the deterministic local embedding encoder and the AI fallback paths.
# Pinned empty so a populated backend/.env can never leak a live key into a test run
# and make results depend on the network.
GEMINI_API_KEY=
AI_PROVIDER=gemini

REDIS_ENABLED=false
EMBEDDING_DIMENSIONS=768
MEMORY_RETRIEVAL_MIN_SIMILARITY=0.05
INGEST_FETCH_TIMEOUT_MS=3000
