# DevRadar Backend Environment
# Copy to .env for local development. Set the same keys in Render/Railway.

NODE_ENV=development
PORT=3001

# Comma-separated frontend origins allowed to call the API.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,https://your-frontend.vercel.app

# Request hardening.
MAX_BODY_SIZE=1mb
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=120

# HydraDB persistent memory. Without these, the app uses an in-memory fallback.
HYDRADB_API_KEY=
HYDRADB_PROJECT_ID=
HYDRADB_BASE_URL=https://api.hydradb.io

# Groq is the preferred AI provider for ingest, chat, and roadmap generation.
GROQ_API_KEY=

# Anthropic is used as fallback and for startup/gap/hackathon analysis.
ANTHROPIC_API_KEY=
