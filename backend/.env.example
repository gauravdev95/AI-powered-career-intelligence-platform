# ─────────────────────────────────────────────────────────────────────────────
# DevRadar backend environment
# Copy to backend/.env for local development; set the same keys in Render.
# Never commit the populated .env — it is gitignored.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=3001

# ── HTTP hardening ───────────────────────────────────────────────────────────
# Comma-separated list of frontend origins allowed to call the API.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,https://your-frontend.vercel.app
# Allow any *.vercel.app origin (convenient for preview deploys; disable to lock down).
CORS_ALLOW_VERCEL_PREVIEWS=true
MAX_BODY_SIZE=1mb
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=120
# Tighter budget for routes that spend model tokens (ingest, chat, roadmap).
AI_RATE_LIMIT_WINDOW_MS=900000
AI_RATE_LIMIT_MAX=30

# ── PostgreSQL — the source of truth ─────────────────────────────────────────
# REQUIRED in production. Must be a PostgreSQL 14+ instance with the pgvector
# extension available (Supabase, Neon, Render Postgres and RDS all ship it).
DATABASE_URL=postgresql://user:password@host:5432/devradar
DATABASE_SSL=false
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=15000
# Apply the schema automatically on boot. Safe and idempotent; set false if you
# prefer to run `npm run db:migrate` as an explicit deploy step.
DATABASE_AUTO_MIGRATE=true

# Driver selection. "pg" is the only supported production driver. "pglite" runs
# PostgreSQL in-process (used by the test suite and for offline development) and
# is rejected outright when NODE_ENV=production.
# DATABASE_DRIVER=pg
# PGLITE_DATA_DIR=./.pglite

# ── Redis (optional) ─────────────────────────────────────────────────────────
# Purely a cache: embeddings and hot reads. The app is fully correct without it,
# but multiple instances should share one so they do not each re-embed the same text.
REDIS_URL=
REDIS_ENABLED=false
REDIS_TTL_SECONDS=300
REDIS_KEY_PREFIX=devradar:

# ── Gemini ───────────────────────────────────────────────────────────────────
# Used for entity extraction, wiki generation, chat, roadmaps and memory extraction.
# Without a key the app still runs: matching, storage, retrieval and the graph all
# work, embeddings fall back to a deterministic local encoder, and generative
# features return safe canned responses.
AI_PROVIDER=gemini
GEMINI_API_KEY=
# Model ids are configuration, never code. Verify the id against Google's current
# model list before deploying; change generations here alone.
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Must match the vector(N) column width. Changing it after data exists requires
# re-embedding — migrate.js refuses to start rather than corrupt search silently.
EMBEDDING_DIMENSIONS=768
AI_TIMEOUT_MS=30000
AI_MAX_RETRIES=2
AI_TEMPERATURE=0.3

# ── Memory engine tuning ─────────────────────────────────────────────────────
# Ranking weights. Normalised at use-time, so they need not sum to 1.
RANK_W_SEMANTIC=0.40
RANK_W_IMPORTANCE=0.15
RANK_W_RECENCY=0.15
RANK_W_CONFIDENCE=0.10
RANK_W_SOURCE_QUALITY=0.10
RANK_W_ACCESS_FREQUENCY=0.10

# Days after which a memory's recency score halves.
MEMORY_RECENCY_HALF_LIFE_DAYS=30
# Cosine similarity at or above which two memories are treated as the same fact.
MEMORY_DUPLICATE_THRESHOLD=0.92
# Similarity floor for retrieval eligibility.
MEMORY_RETRIEVAL_MIN_SIMILARITY=0.15
MEMORY_RETRIEVAL_CANDIDATES=60
MEMORY_RETRIEVAL_TOP_K=12
# Hard character budget for the assembled RAG context. This is what guarantees the
# whole wiki is never sent to the model, however large it grows.
MEMORY_CONTEXT_CHAR_BUDGET=6000
WIKI_CHUNK_SIZE=900
WIKI_CHUNK_OVERLAP=150
# Recent chat turns used as short-term memory, and how many are retained at all.
MEMORY_CONVERSATION_WINDOW=8
MEMORY_CONVERSATION_RETENTION=50

# ── URL ingestion (SSRF controls) ────────────────────────────────────────────
INGEST_MAX_INPUT_CHARS=12000
INGEST_MAX_FETCH_BYTES=2097152
INGEST_FETCH_TIMEOUT_MS=10000
INGEST_MAX_REDIRECTS=3
# Optional hostname allowlist. When set, only these hosts (and subdomains) may be
# fetched — the strongest available SSRF control if your users only ingest from
# known job boards.
INGEST_ALLOWED_HOSTS=
INGEST_BLOCKED_HOSTS=
# Development-only escape hatch for fetching localhost fixtures. Force-disabled
# whenever NODE_ENV=production.
INGEST_ALLOW_PRIVATE_NETWORK=false
