{
  "name": "devradar-backend",
  "version": "1.0.0",
  "description": "DevRadar backend - AI-powered developer career intelligence with HydraDB memory",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "build": "node --check server.js",
    "start": "node server.js",
    "dev": "node --watch server.js",
    "health": "node -e \"fetch('http://localhost:' + (process.env.PORT || 3001) + '/api/health').then(r => r.json()).then(console.log)\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "node-fetch": "^3.3.2",
    "turndown": "^7.2.4",
    "uuid": "^10.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
