{
  "name": "grafted-backend",
  "version": "2.0.0",
  "description": "Grafted backend — Career Memory Engine on PostgreSQL + pgvector with Gemini",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "build": "node --check server.js",
    "test": "node --env-file=tests/.env.test --test --test-timeout=180000 tests/",
    "test:watch": "node --env-file=tests/.env.test --test --watch tests/",
    "data:check": "node scripts/check-data-links.js",
    "db:migrate": "node db/migrate.js",
    "db:reset": "node db/migrate.js --reset",
    "health": "node -e \"fetch('http://localhost:' + (process.env.PORT || 3001) + '/api/health').then(r => r.json()).then(o => console.log(JSON.stringify(o, null, 2)))\""
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "pg": "^8.13.0",
    "turndown": "^7.2.4",
    "uuid": "^10.0.0"
  },
  "optionalDependencies": {
    "redis": "^4.7.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.0"
  },
  "engines": {
    "node": ">=20.6.0"
  }
}
